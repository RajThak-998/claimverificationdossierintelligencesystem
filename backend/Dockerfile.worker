# Multi-stage Dockerfile for Motor Platform Go Background Worker
FROM golang:1.26-alpine AS builder

WORKDIR /app
RUN apk add --no-cache gcc musl-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-s -w" -o /app/motor-worker ./cmd/worker

# Final minimal runtime container with FFmpeg
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata ffmpeg chromium font-noto

WORKDIR /app
COPY --from=builder /app/motor-worker .

CMD ["/app/motor-worker"]
