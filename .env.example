# ==============================================================================
# Motor Claim Verification Platform - Environment Configuration
# ==============================================================================

# Server & Network Configuration
APP_ENV=production
PORT=8080
DOMAIN_NAME=localhost
CORS_ALLOWED_ORIGINS=*

# PostgreSQL Database Configuration
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=motor_claims
DB_USER=postgres
DB_PASSWORD=SecretPostgresPass123!
DB_DSN=postgres://postgres:SecretPostgresPass123!@localhost:5432/motor_claims?sslmode=disable

# Redis & Asynq Worker Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Storage Abstraction Configuration (minio | s3 | local)
STORAGE_DRIVER=local
STORAGE_BASE_DIR=data/storage
STORAGE_BASE_URL=http://localhost:8080
STORAGE_ENDPOINT=localhost:9000
STORAGE_BUCKET=motor-claims-vault
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadminpassword123
STORAGE_USE_SSL=false

# For AWS S3 in Production:
# STORAGE_DRIVER=s3
# STORAGE_REGION=ap-south-1
# STORAGE_BUCKET=prod-motor-claims-vault
# STORAGE_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# STORAGE_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Security & Authentication
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-chars-long
JWT_EXPIRATION_HOURS=24

# Commercial & Invoice Defaults
BASE_CASE_FEE_INR=750.00
DEFAULT_PER_MINUTE_RATE_INR=45.00
